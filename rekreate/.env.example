# Copy to .env and fill in. .env is gitignored (constraint 12).
# Never commit a real value here.

# --- Google Places API (New) ---------------------------------------------
# Requires a GCP project with "Places API (New)" enabled and billing attached.
# The legacy Places API will not work (constraint 2).
GOOGLE_MAPS_API_KEY=

# --- Postgres (the Codex Supabase instance) --------------------------------
# Pooled connection string from Supabase: Project Settings > Database >
# Connection string > Transaction pooler.
#
# This engine writes ONLY into the `outbound` schema. It never reads or writes
# website_leads, lead_notes, or any other Codex table — those hold inbound
# leads with a consent audit trail that scraped prospects must not touch.
DATABASE_URL=
DB_SCHEMA=outbound

# --- Anthropic (pitch stage, Phase 5) -------------------------------------
ANTHROPIC_API_KEY=

# --- Google Sheets export (Phase 5) ---------------------------------------
# NOTE: the Places API key above CANNOT write to Sheets. Writing requires a
# service account. Create one, download its JSON key, and share the target
# spreadsheet with the service account's email address as an EDITOR.
#
# The ID is the part of the sheet URL between /d/ and /edit:
#   docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=1VFBHcbtfMmUu6p6mGw2bMExFdZ8iiwev3BAfEXaxgTE

# Path to the downloaded service-account JSON key.
# Gitignored via the *-service-account.json rule. Treat it as a password.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./rekreate-service-account.json

# Tab names. "Leads" must exist before the first run; the tool creates the
# other two if they are missing.
SHEETS_TAB_LEADS=Leads
SHEETS_TAB_RUNS=Runs
SHEETS_TAB_DISQUALIFIED=Disqualified

# --- Run defaults (overridable per run via CLI flags) ---------------------
# Per-run ceiling — the sweep halts when this many Places calls are spent.
# The small guard. PLACES_DAILY_LIMIT below is the one that protects the bill.
MAX_CALLS=25
# Places calls per US/Pacific day, matching Google's own quota reset.
# 30 x 31 = 930, inside the 1,000/month Enterprise free allowance.
# Raise only after redoing that arithmetic: 35/day is 1,085 in a long month.
PLACES_DAILY_LIMIT=30
# Recursion floor for rectangle tiling. 1 = a tile may be quartered once.
MAX_TILE_DEPTH=1
# Minimum score at which the pitch stage runs (constraint 8).
PITCH_SCORE_THRESHOLD=75
# Google cache TTL in days (constraint 5). Do not raise above 30.
GOOGLE_CACHE_TTL_DAYS=30

LOG_LEVEL=info

# Apps Script ingest — deploy apps-script/Code.gs as a Web App and paste its
# /exec URL here. The token must match INGEST_TOKEN inside Code.gs.
SHEETS_WEBAPP_URL=
SHEETS_INGEST_TOKEN=
